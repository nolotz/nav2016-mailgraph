<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(AddinTargetFrameworks)</TargetFrameworks>
    <AssemblyName>NavMailGraph.Msal</AssemblyName>
    <RootNamespace>NavMailGraph.Msal</RootNamespace>
    <Description>Optional MSAL (Microsoft.Identity.Client) token provider for NavMailGraph.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NavMailGraph/NavMailGraph.csproj" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NavMailGraph.Tests" />
  </ItemGroup>

</Project>
